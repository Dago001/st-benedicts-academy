#     Deny from all
# </FilesMatch>

# <FilesMatch "(^config\.php|^database\.php|\.sql$|\.log$)">
#     Order allow,deny
#     Deny from all
# </FilesMatch>

# # Protect includes folder
# RewriteRule ^includes/.*$ - [F,L]
# RewriteRule ^config/.*$ - [F,L]

