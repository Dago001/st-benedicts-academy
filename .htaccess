# Apache 2.4+ configuration
Options -Indexes +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS in production (skipped for localhost / dev hosts)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Clean URLs: /admin/students -> admin/students.php (and /admin/ -> index.php)
    # 1) Old .php addresses redirect (GET only) to the clean form
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)(/index)?\.php[\s?] [NC]
    RewriteCond %{DOCUMENT_ROOT}/%1.php -f
    RewriteRule ^ /%1 [R=301,L,NE]
    RewriteRule ^index$ / [R=301,L]
    # 2) Internal mapping of clean URLs to files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # Never serve internals directly
    RewriteRule ^(config|includes|sql|scripts|tests|logs|backups|storage|docs|\.github)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Hidden files, dumps, logs, env files
<FilesMatch "(^\.|\.(sql|log|bak|sh|md|lock|env|ini|py)$|^(README|DEPLOYMENT)$)">
    Require all denied
</FilesMatch>
<FilesMatch "^\.well-known$">
    Require all granted
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

ErrorDocument 403 /error/403.php
ErrorDocument 404 /error/404.php
